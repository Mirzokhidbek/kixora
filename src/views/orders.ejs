<%- include('includes/header') %>

<main class="container-fluid px-lg-5 my-4 flex-grow-1">
  <!-- Title Bar & Order Metrics -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0">Footwear Orders & Logistics</h2>
        <span class="badge bg-dark rounded-pill px-3 py-1 fw-bold text-warning">
          <%= orders ? orders.length : 0 %> Total Orders
        </span>
      </div>
      <p class="text-muted mb-0">
        Review real-time luxury footwear shipments, customer delivery destinations, transition order fulfillment states, and generate courier slips.
      </p>
    </div>

    <!-- Quick Filter Stat Counters -->
    <div class="d-flex gap-2 flex-wrap">
      <% 
        const pauseCount = orders ? orders.filter(o => o.orderStatus === 'PAUSE').length : 0;
        const processCount = orders ? orders.filter(o => o.orderStatus === 'PROCESS').length : 0;
        const finishCount = orders ? orders.filter(o => o.orderStatus === 'FINISH').length : 0;
      %>
      <span class="badge bg-warning bg-opacity-25 text-dark border border-warning border-opacity-50 px-3 py-2 fw-bold">
        <i class="fa-solid fa-hourglass-half text-warning me-1"></i> <%= pauseCount %> Pending
      </span>
      <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 px-3 py-2 fw-bold">
        <i class="fa-solid fa-truck-fast text-primary me-1"></i> <%= processCount %> In Transit
      </span>
      <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2 fw-bold">
        <i class="fa-solid fa-circle-check text-success me-1"></i> <%= finishCount %> Delivered
      </span>
    </div>
  </div>

  <!-- Search & Filter Tabs Bar -->
  <div class="admin-card p-3 mb-4" style="border-radius: 14px; border: 1px solid #e5e7eb; background: #ffffff;">
    <div class="row g-2 align-items-center">
      <!-- Search Input -->
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" id="orderSearchInput" class="form-control border-start-0 bg-light" placeholder="Search by customer, phone, or order #ID...">
        </div>
      </div>

      <!-- Status Filter Tabs -->
      <div class="col-md-7">
        <div class="d-flex flex-wrap gap-1.5 justify-content-md-end">
          <button type="button" class="btn btn-sm btn-dark order-status-filter-btn active" data-status="ALL">
            All (<%= orders ? orders.length : 0 %>)
          </button>
          <button type="button" class="btn btn-sm btn-outline-warning order-status-filter-btn text-dark" data-status="PAUSE">
            <i class="fa-solid fa-hourglass-half me-1 text-warning"></i> Pending (<%= pauseCount %>)
          </button>
          <button type="button" class="btn btn-sm btn-outline-primary order-status-filter-btn" data-status="PROCESS">
            <i class="fa-solid fa-truck-fast me-1"></i> In Transit (<%= processCount %>)
          </button>
          <button type="button" class="btn btn-sm btn-outline-success order-status-filter-btn" data-status="FINISH">
            <i class="fa-solid fa-circle-check me-1"></i> Delivered (<%= finishCount %>)
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders Table Container -->
  <div class="admin-table-container">
    <div class="table-responsive">
      <table class="table admin-table align-middle mb-0" id="ordersTable">
        <thead>
          <tr>
            <th scope="col" class="ps-4">Order ID & Date</th>
            <th scope="col">Customer Info</th>
            <th scope="col">Ordered Footwear & Size</th>
            <th scope="col">Total Amount</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-center">Invoice</th>
            <th scope="col" class="text-center pe-4">1-Click Fulfillment Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders && orders.length) { %>
            <% orders.forEach((order, index) => { %>
              <tr class="order-row"
                  data-order-id="<%= String(order._id) %>"
                  data-display-id="kx-<%= String(order._id).slice(-6).toLowerCase() %>"
                  data-status="<%= order.orderStatus %>"
                  data-customer="<%= (order.memberData ? order.memberData.memberNick : 'Guest').toLowerCase() %>"
                  data-phone="<%= (order.memberData ? order.memberData.memberPhone : '').toLowerCase() %>"
                  data-email="<%= (order.memberData ? order.memberData.memberEmail : '').toLowerCase() %>"
                  data-address="<%= (order.memberData ? order.memberData.memberAddress : 'Express Courier Delivery') %>"
                  data-total="<%= Number(order.orderTotal).toFixed(2) %>"
                  data-date="<%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>">
                <!-- Order ID & Date -->
                <td class="ps-4">
                  <div class="fw-bold text-dark font-monospace">
                    #KX-<%= String(order._id).slice(-6).toUpperCase() %>
                  </div>
                  <div class="small text-muted">
                    <i class="fa-regular fa-clock me-1"></i>
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </div>
                </td>

                <!-- Customer Details -->
                <td>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                      <%= order.memberData ? order.memberData.memberNick.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <div class="fw-bold text-dark"><%= order.memberData ? order.memberData.memberNick : 'Customer' %></div>
                      <div class="small text-muted">
                        <i class="fa-solid fa-phone text-muted me-1"></i> <%= order.memberData ? order.memberData.memberPhone : 'N/A' %>
                      </div>
                    </div>
                  </div>
                  <div class="small text-muted" style="max-width: 220px; font-size: 0.78rem;">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= (order.memberData && order.memberData.memberAddress) ? order.memberData.memberAddress : 'Tashkent, Uzbekistan (Standard Delivery)' %>
                  </div>
                </td>

                <!-- Ordered Footwear Items -->
                <td>
                  <div class="d-flex flex-column gap-2" style="max-width: 320px;">
                    <% if (order.orderItems && order.orderItems.length) { %>
                      <% order.orderItems.forEach((item, itemIdx) => { %>
                        <% 
                          const product = order.productData ? order.productData.find(p => String(p._id) === String(item.productId)) : null;
                          let shoeImg = '/img/kixora/sneakers.jpg';
                          if (product && product.productImages && product.productImages.length) {
                            const raw = product.productImages[0];
                            shoeImg = raw.startsWith('http') ? raw : '/' + raw.replace(/^public\//, '').replace(/^\//, '');
                          }
                          const shoeName = product ? product.productName : 'KIXORA Performance Sneaker';
                          const shoeSize = (product && product.productSize) ? product.productSize : '42';
                        %>
                        <div class="d-flex align-items-center gap-2 bg-light p-1.5 rounded-3 border">
                          <img src="<%= shoeImg %>" 
                               alt="<%= shoeName %>" 
                               style="width: 38px; height: 38px; object-fit: contain; background: #fff; border-radius: 6px; padding: 2px;"
                               onerror="this.src='/img/kixora/sneakers.jpg'">
                          <div class="overflow-hidden">
                            <div class="fw-semibold text-dark text-truncate" style="font-size: 0.84rem;">
                              <%= shoeName %>
                            </div>
                            <div class="small text-muted d-flex align-items-center gap-2">
                              <span class="badge bg-dark text-white px-1.5 py-0.5" style="font-size: 0.68rem;">EU <%= shoeSize %></span>
                              <span>Qty: <strong><%= item.itemQuantity %></strong></span>
                              <span class="text-success fw-semibold">$<%= Number(item.itemPrice || (order.orderTotal / order.orderItems.length)).toFixed(2) %></span>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <div class="text-muted small">No items listed</div>
                    <% } %>
                  </div>
                </td>

                <!-- Total Amount -->
                <td>
                  <div class="fw-bold text-dark fs-5 mb-0.5">
                    $<%= Number(order.orderTotal).toFixed(2) %>
                  </div>
                  <div class="small text-muted d-flex align-items-center gap-1">
                    <i class="fa-regular fa-credit-card text-primary"></i>
                    <span>Card / Click</span>
                  </div>
                </td>

                <!-- Status Badge -->
                <td>
                  <span id="order-status-badge-<%= order._id %>" class="badge-status <%= order.orderStatus.toLowerCase() %>">
                    <%= order.orderStatus %>
                  </span>
                </td>

                <!-- Printable Courier Slip -->
                <td class="text-center">
                  <button type="button" 
                          class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 view-invoice-trigger"
                          data-order-id="<%= String(order._id) %>"
                          data-display-id="#KX-<%= String(order._id).slice(-6).toUpperCase() %>"
                          data-status="<%= order.orderStatus %>"
                          data-customer="<%= order.memberData ? order.memberData.memberNick : 'Customer' %>"
                          data-phone="<%= order.memberData ? order.memberData.memberPhone : 'N/A' %>"
                          data-email="<%= order.memberData ? order.memberData.memberEmail : 'N/A' %>"
                          data-address="<%= (order.memberData && order.memberData.memberAddress) ? order.memberData.memberAddress : 'Tashkent, Uzbekistan' %>"
                          data-total="<%= Number(order.orderTotal).toFixed(2) %>"
                          data-date="<%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>">
                    <i class="fa-solid fa-receipt me-1"></i> Slip
                  </button>
                </td>

                <!-- 1-Click Status Transitions -->
                <td class="text-center pe-4">
                  <div class="btn-group" role="group" id="action-group-<%= order._id %>">
                    <% if (order.orderStatus === 'PAUSE') { %>
                      <button type="button" 
                              class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold status-step-btn"
                              data-id="<%= order._id %>" 
                              data-next="PROCESS">
                        <i class="fa-solid fa-truck-fast me-1"></i> Ship Order
                      </button>
                    <% } else if (order.orderStatus === 'PROCESS') { %>
                      <button type="button" 
                              class="btn btn-sm btn-success rounded-pill px-3 py-1.5 fw-semibold status-step-btn"
                              data-id="<%= order._id %>" 
                              data-next="FINISH">
                        <i class="fa-solid fa-circle-check me-1"></i> Mark Delivered
                      </button>
                    <% } else { %>
                      <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                        <i class="fa-solid fa-check-double me-1"></i> Completed
                      </span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <div class="p-4">
                  <i class="fa-solid fa-box-open fa-3x mb-3 text-secondary d-block"></i>
                  <h5 class="fw-bold text-dark">No Customer Orders Yet</h5>
                  <p class="small text-muted mb-0">Customer orders placed through the KIXORA store will appear here in real-time.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Printable Invoice / Courier Slip Modal -->
  <div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
        <div class="modal-header bg-dark text-white border-0 py-3 px-4">
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-receipt fs-5 text-warning"></i>
            <h5 class="modal-title fw-bold mb-0">Courier Packing Slip & Invoice</h5>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4" id="printableInvoiceArea">
          <!-- Invoice Header -->
          <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
              <h3 class="fw-black text-dark mb-0 font-monospace" style="letter-spacing: 2px;">KIXORA</h3>
              <div class="small text-muted">Luxury Footwear Fulfillment Suite</div>
            </div>
            <div class="text-end">
              <h5 class="fw-bold text-dark mb-0 font-monospace" id="invoiceOrderNumber">#KX-000000</h5>
              <div class="small text-muted" id="invoiceOrderDate">Date</div>
              <span class="badge bg-dark text-white mt-1" id="invoiceOrderStatus">STATUS</span>
            </div>
          </div>

          <!-- Customer & Shipping Box -->
          <div class="row g-3 mb-4">
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border">
                <div class="small text-muted fw-bold text-uppercase mb-1">Customer / Recipient</div>
                <div class="fw-bold text-dark" id="invoiceCustomerName">Name</div>
                <div class="small text-muted" id="invoiceCustomerPhone">Phone</div>
                <div class="small text-muted" id="invoiceCustomerEmail">Email</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 bg-light rounded-3 border">
                <div class="small text-muted fw-bold text-uppercase mb-1">Shipping Destination</div>
                <div class="fw-bold text-dark" id="invoiceCustomerAddress">Address</div>
                <div class="small text-muted mt-1"><i class="fa-solid fa-truck-fast text-primary me-1"></i> Express Courier Delivery</div>
              </div>
            </div>
          </div>

          <!-- Total & Payment -->
          <div class="d-flex justify-content-between align-items-center p-3 rounded-3" style="background: #090a0f; color: #fff;">
            <div>
              <div class="small text-slate-400">Total Order Amount (Tax & Express Included)</div>
              <div class="fs-4 fw-bold text-warning" id="invoiceTotalAmount">$0.00</div>
            </div>
            <div class="text-end">
              <div class="small text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> Payment Verified</div>
              <div class="small text-slate-400">Card / Click Online</div>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light border-0 py-3 px-4">
          <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-dark rounded-3 px-4 fw-semibold" id="printInvoiceBtn">
            <i class="fa-solid fa-print me-1.5"></i> Print Packing Slip
          </button>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/js/orders.js"></script>

<%- include('includes/footer') %>
