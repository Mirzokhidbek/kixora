<%- include('includes/header') %>

<main class="container-fluid px-lg-5 my-4 flex-grow-1">
  <!-- Title Bar & Overview -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0 tracking-tight" style="font-size: 1.45rem;">Orders & Logistics</h2>
        <span class="badge bg-dark text-white rounded-pill px-2.5 py-1" style="font-size: 0.75rem; font-weight: 600;">
          <%= orders ? orders.length : 0 %> Orders
        </span>
      </div>
      <p class="text-muted mb-0 small">
        Fulfillment pipeline, real-time shipment destinations, status transitions, and courier packing slips.
      </p>
    </div>

    <!-- Quick Status Counters -->
    <div class="d-flex gap-2 flex-wrap">
      <% 
        const pauseCount = orders ? orders.filter(o => o.orderStatus === 'PAUSE').length : 0;
        const processCount = orders ? orders.filter(o => o.orderStatus === 'PROCESS').length : 0;
        const finishCount = orders ? orders.filter(o => o.orderStatus === 'FINISH').length : 0;
      %>
      <div class="d-flex align-items-center gap-1.5 px-3 py-1.5 bg-white rounded-pill border" style="font-size: 0.8rem; font-weight: 600;">
        <span class="rounded-circle" style="width: 8px; height: 8px; background: #f59e0b;"></span>
        <span class="text-secondary">Pending:</span>
        <span class="text-dark fw-bold"><%= pauseCount %></span>
      </div>
      <div class="d-flex align-items-center gap-1.5 px-3 py-1.5 bg-white rounded-pill border" style="font-size: 0.8rem; font-weight: 600;">
        <span class="rounded-circle" style="width: 8px; height: 8px; background: #6366f1;"></span>
        <span class="text-secondary">In Transit:</span>
        <span class="text-dark fw-bold"><%= processCount %></span>
      </div>
      <div class="d-flex align-items-center gap-1.5 px-3 py-1.5 bg-white rounded-pill border" style="font-size: 0.8rem; font-weight: 600;">
        <span class="rounded-circle" style="width: 8px; height: 8px; background: #10b981;"></span>
        <span class="text-secondary">Delivered:</span>
        <span class="text-dark fw-bold"><%= finishCount %></span>
      </div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="admin-card p-3 mb-4">
    <div class="row g-2 align-items-center">
      <!-- Search Input -->
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-light); font-size: 0.85rem;">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input type="text" id="orderSearchInput" class="form-control border-start-0 ps-0 bg-white" style="border-color: var(--border-light); font-size: 0.88rem;" placeholder="Search customer name, phone, or #KX ID...">
        </div>
      </div>

      <!-- Status Filter Pills -->
      <div class="col-md-7">
        <div class="d-flex flex-wrap gap-1.5 justify-content-md-end">
          <button type="button" class="filter-pill-btn order-status-filter-btn active" data-status="ALL">
            All (<%= orders ? orders.length : 0 %>)
          </button>
          <button type="button" class="filter-pill-btn order-status-filter-btn" data-status="PAUSE">
            <span class="rounded-circle d-inline-block me-1" style="width: 7px; height: 7px; background: #f59e0b;"></span> Pending (<%= pauseCount %>)
          </button>
          <button type="button" class="filter-pill-btn order-status-filter-btn" data-status="PROCESS">
            <span class="rounded-circle d-inline-block me-1" style="width: 7px; height: 7px; background: #6366f1;"></span> In Transit (<%= processCount %>)
          </button>
          <button type="button" class="filter-pill-btn order-status-filter-btn" data-status="FINISH">
            <span class="rounded-circle d-inline-block me-1" style="width: 7px; height: 7px; background: #10b981;"></span> Delivered (<%= finishCount %>)
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="admin-table-container">
    <div class="table-responsive">
      <table class="table admin-table align-middle mb-0" id="ordersTable">
        <thead>
          <tr>
            <th scope="col" class="ps-4">Order ID & Date</th>
            <th scope="col">Customer</th>
            <th scope="col">Footwear & Specs</th>
            <th scope="col">Total</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-center">Invoice</th>
            <th scope="col" class="text-center pe-4">Fulfillment Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (orders && orders.length) { %>
            <% orders.forEach((order, index) => { %>
              <tr class="order-row"
                  data-order-id="<%= String(order._id) %>"
                  data-display-id="kx-<%= String(order._id).slice(-6).toLowerCase() %>"
                  data-status="<%= order.orderStatus %>"
                  data-customer="<%= (order.memberData && order.memberData.memberNick ? order.memberData.memberNick : 'Guest').toLowerCase() %>"
                  data-phone="<%= (order.memberData && order.memberData.memberPhone ? order.memberData.memberPhone : '').toLowerCase() %>"
                  data-email="<%= (order.memberData && order.memberData.memberEmail ? order.memberData.memberEmail : '').toLowerCase() %>"
                  data-address="<%= (order.memberData && order.memberData.memberAddress ? order.memberData.memberAddress : 'Express Courier Delivery') %>"
                  data-total="<%= Number(order.orderTotal || 0).toFixed(2) %>"
                  data-date="<%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>">
                
                <!-- Order ID & Date -->
                <td class="ps-4">
                  <div class="fw-bold text-dark font-monospace" style="letter-spacing: 0.02em; font-size: 0.9rem;">
                    #KX-<%= String(order._id).slice(-6).toUpperCase() %>
                  </div>
                  <div class="text-muted" style="font-size: 0.76rem;">
                    <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                  </div>
                </td>

                <!-- Customer Details -->
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                      <%= (order.memberData && order.memberData.memberNick) ? order.memberData.memberNick.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                      <div class="fw-bold text-dark" style="font-size: 0.88rem;">
                        <%= (order.memberData && order.memberData.memberNick) ? order.memberData.memberNick : 'Customer' %>
                      </div>
                      <div class="text-muted" style="font-size: 0.78rem;">
                        <i class="fa-solid fa-phone me-1 text-muted" style="font-size: 0.7rem;"></i> <%= (order.memberData && order.memberData.memberPhone) ? order.memberData.memberPhone : 'N/A' %>
                      </div>
                    </div>
                  </div>
                </td>

                <!-- Ordered Footwear Items -->
                <td>
                  <div class="d-flex flex-column gap-1.5" style="max-width: 300px;">
                    <% if (order.orderItems && order.orderItems.length) { %>
                      <% order.orderItems.forEach((item, itemIdx) => { %>
                        <% 
                          const product = order.productData ? order.productData.find(p => String(p._id) === String(item.productId)) : null;
                          let shoeImg = '/img/kixora/sneakers.jpg';
                          if (product && product.productImages && product.productImages.length) {
                            const raw = product.productImages[0];
                            shoeImg = raw.startsWith('http') ? raw : '/' + raw.replace(/^public\//, '').replace(/^\//, '');
                          }
                          const shoeName = product ? product.productName : 'KIXORA Performance Sneaker';
                          const shoeSize = (product && product.productSize) ? product.productSize : '42';
                        %>
                        <div class="d-flex align-items-center gap-2 p-1 rounded-2 bg-light border" style="border-color: var(--border-light) !important;">
                          <img src="<%= shoeImg %>" 
                               alt="<%= shoeName %>" 
                               class="rounded-1"
                               style="width: 32px; height: 32px; object-fit: contain; background: #ffffff; padding: 2px;"
                               onerror="this.src='/img/kixora/sneakers.jpg'">
                          <div class="overflow-hidden flex-grow-1">
                            <div class="fw-semibold text-dark text-truncate" style="font-size: 0.82rem;">
                              <%= shoeName %>
                            </div>
                            <div class="text-muted d-flex align-items-center gap-2" style="font-size: 0.74rem;">
                              <span class="badge bg-white text-dark border px-1.5 py-0.5" style="font-size: 0.68rem; font-weight: 600;">EU <%= shoeSize %></span>
                              <span>x<%= item.itemQuantity %></span>
                              <span class="text-dark fw-semibold">$<%= Number(item.itemPrice || (order.orderTotal / (order.orderItems.length || 1))).toFixed(2) %></span>
                            </div>
                          </div>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <div class="text-muted small">No items listed</div>
                    <% } %>
                  </div>
                </td>

                <!-- Total Amount -->
                <td>
                  <div class="fw-bold text-dark mb-0 font-monospace" style="font-size: 0.95rem;">
                    $<%= Number(order.orderTotal || 0).toFixed(2) %>
                  </div>
                  <div class="text-muted d-flex align-items-center gap-1" style="font-size: 0.74rem;">
                    <i class="fa-regular fa-credit-card"></i>
                    <span>Card Verified</span>
                  </div>
                </td>

                <!-- Status Badge -->
                <td>
                  <span id="order-status-badge-<%= order._id %>" class="badge-status <%= order.orderStatus.toLowerCase() %>">
                    <%= order.orderStatus %>
                  </span>
                </td>

                <!-- Printable Courier Slip -->
                <td class="text-center">
                  <button type="button" 
                          class="btn-brand-outline rounded-2 px-2.5 py-1 view-invoice-trigger"
                          style="font-size: 0.78rem;"
                          data-order-id="<%= String(order._id) %>"
                          data-display-id="#KX-<%= String(order._id).slice(-6).toUpperCase() %>"
                          data-status="<%= order.orderStatus %>"
                          data-customer="<%= (order.memberData && order.memberData.memberNick) ? order.memberData.memberNick : 'Customer' %>"
                          data-phone="<%= (order.memberData && order.memberData.memberPhone) ? order.memberData.memberPhone : 'N/A' %>"
                          data-email="<%= (order.memberData && order.memberData.memberEmail) ? order.memberData.memberEmail : 'N/A' %>"
                          data-address="<%= (order.memberData && order.memberData.memberAddress) ? order.memberData.memberAddress : 'Tashkent, Uzbekistan' %>"
                          data-total="<%= Number(order.orderTotal || 0).toFixed(2) %>"
                          data-date="<%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>">
                    <i class="fa-solid fa-receipt me-1"></i> Slip
                  </button>
                </td>

                <!-- 1-Click Status Transitions -->
                <td class="text-center pe-4">
                  <div class="btn-group" role="group" id="action-group-<%= order._id %>">
                    <% if (order.orderStatus === 'PAUSE') { %>
                      <button type="button" 
                              class="btn-brand-dark rounded-2 px-3 py-1 fw-semibold status-step-btn"
                              style="font-size: 0.8rem;"
                              data-id="<%= order._id %>" 
                              data-next="PROCESS">
                        <i class="fa-solid fa-truck-fast me-1"></i> Ship Order
                      </button>
                    <% } else if (order.orderStatus === 'PROCESS') { %>
                      <button type="button" 
                              class="btn btn-sm btn-dark rounded-2 px-3 py-1 fw-semibold status-step-btn"
                              style="font-size: 0.8rem; background: #059669; border-color: #059669;"
                              data-id="<%= order._id %>" 
                              data-next="FINISH">
                        <i class="fa-solid fa-circle-check me-1"></i> Mark Delivered
                      </button>
                    <% } else { %>
                      <span class="badge bg-light text-secondary border px-2.5 py-1.5 rounded-2 fw-semibold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-check-double me-1 text-success"></i> Completed
                      </span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <div class="p-4">
                  <i class="fa-solid fa-box-open fa-2x mb-2 text-muted d-block opacity-50"></i>
                  <div class="fw-bold text-dark">No Customer Orders Yet</div>
                  <p class="small text-muted mb-0">Customer footwear orders placed through the store will appear here in real-time.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Printable Invoice / Courier Slip Modal -->
  <div class="modal fade" id="invoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content overflow-hidden">
        <div class="modal-header bg-dark text-white border-0 py-3 px-4">
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-receipt text-muted"></i>
            <h6 class="modal-title fw-bold mb-0">Courier Packing Slip & Dispatch Manifest</h6>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4" id="printableInvoiceArea" style="background: #ffffff;">
          <!-- Invoice Header -->
          <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
            <div>
              <h4 class="fw-black text-dark mb-0 font-monospace" style="letter-spacing: 2px;">KIXORA</h4>
              <div class="text-muted" style="font-size: 0.78rem;">Luxury Footwear Fulfillment Suite</div>
            </div>
            <div class="text-end">
              <div class="fw-bold text-dark font-monospace" style="font-size: 1.05rem;" id="invoiceOrderNumber">#KX-000000</div>
              <div class="text-muted" style="font-size: 0.78rem;" id="invoiceOrderDate">Date</div>
              <span class="badge bg-dark text-white rounded-1 mt-1" style="font-size: 0.68rem;" id="invoiceOrderStatus">STATUS</span>
            </div>
          </div>

          <!-- Customer & Shipping Box -->
          <div class="row g-3 mb-4">
            <div class="col-6">
              <div class="p-3 bg-light rounded-2 border">
                <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.68rem; letter-spacing: 0.05em;">Customer Details</div>
                <div class="fw-bold text-dark" id="invoiceCustomerName">Name</div>
                <div class="text-muted small" id="invoiceCustomerPhone">Phone</div>
                <div class="text-muted small" id="invoiceCustomerEmail">Email</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 bg-light rounded-2 border">
                <div class="text-muted fw-bold text-uppercase mb-1" style="font-size: 0.68rem; letter-spacing: 0.05em;">Delivery Destination</div>
                <div class="fw-bold text-dark" id="invoiceCustomerAddress">Address</div>
                <div class="text-muted small mt-1"><i class="fa-solid fa-truck-fast me-1"></i> Express Courier Delivery</div>
              </div>
            </div>
          </div>

          <!-- Total & Payment -->
          <div class="d-flex justify-content-between align-items-center p-3 rounded-2 bg-dark text-white">
            <div>
              <div class="text-secondary" style="font-size: 0.75rem;">Total Order Amount (Tax & Delivery Included)</div>
              <div class="fs-4 fw-bold font-monospace text-white" id="invoiceTotalAmount">$0.00</div>
            </div>
            <div class="text-end">
              <div class="small text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i> Payment Verified</div>
              <div class="text-secondary" style="font-size: 0.75rem;">Card / Click Online</div>
            </div>
          </div>
        </div>

        <div class="modal-footer bg-light border-0 py-2.5 px-4">
          <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn-brand-dark rounded-2 px-3 py-1.5" id="printInvoiceBtn">
            <i class="fa-solid fa-print me-1.5"></i> Print Packing Slip
          </button>
        </div>
      </div>
    </div>
  </div>
</main>

<script src="/js/orders.js"></script>

<%- include('includes/footer') %>
