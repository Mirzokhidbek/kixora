<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIXORA Footwear - Brand Admin Suite</title>
  
  <!-- Favicon icon -->
  <link rel="icon" type="image/png" href="https://img.icons8.com/color/96/running-shoes.png">

  <!-- Bootstrap 5.3 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- FontAwesome 6.5 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Custom Design System -->
  <link rel="stylesheet" href="/css/main.css">

  <!-- Core Libraries: jQuery, Bootstrap & Axios (Loaded in Head to prevent $ not defined) -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body>
  <!-- Header Navbar -->
  <header class="admin-navbar">
    <div class="container-fluid px-lg-5">
      <nav class="navbar navbar-expand-lg navbar-dark p-0">
        <a class="navbar-brand" href="/admin">
          <div class="brand-icon" style="background: linear-gradient(135deg, #ff4655, #f59e0b);">
            <i class="fa-solid fa-shoe-prints"></i>
          </div>
          <span>KIXORA <span class="text-warning fw-normal">ADMIN</span></span>
        </a>
        
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
          <i class="fa-solid fa-bars text-white fs-4"></i>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-1">
            <% if (member) { %>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin">
                  <i class="fa-solid fa-chart-pie"></i> Dashboard
                </a>
              </li>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin/product/all">
                  <i class="fa-solid fa-shoe-prints"></i> Footwear Catalog
                </a>
              </li>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin/order/all">
                  <i class="fa-solid fa-boxes-packing"></i> Orders
                </a>
              </li>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin/user/all">
                  <i class="fa-solid fa-users"></i> Customers
                </a>
              </li>
              <li class="nav-item ms-lg-3 mt-2 mt-lg-0 d-flex align-items-center gap-2">
                <div class="admin-user-badge">
                  <i class="fa-solid fa-crown text-warning"></i>
                  <span><%= member.memberNick %></span>
                </div>
                <a class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-semibold" href="/admin/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> Logout
                </a>
              </li>
            <% } else { %>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin">
                  <i class="fa-solid fa-house"></i> Home
                </a>
              </li>
              <li class="nav-item">
                <a class="admin-nav-link" href="/admin/login">
                  <i class="fa-solid fa-right-to-bracket"></i> Login
                </a>
              </li>
              <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                <a class="btn-gold" href="/admin/signup">
                  <i class="fa-solid fa-user-plus"></i> Register Brand
                </a>
              </li>
            <% } %>
          </ul>
        </div>
      </nav>
    </div>
  </header>
