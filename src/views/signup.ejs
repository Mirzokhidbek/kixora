<%- include('includes/header') %>

<div class="auth-wrapper flex-grow-1">
  <div class="auth-card" style="max-width: 540px;">
    <div class="auth-header">
      <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.3rem; background: linear-gradient(135deg, #ff4655, #f59e0b);">
        <i class="fa-solid fa-shoe-prints"></i>
      </div>
      <h3 class="fw-bold mb-1">Register KIXORA Store</h3>
      <p class="text-slate-400 small mb-0" style="color: #94a3b8;">Establish your brand administrative root console</p>
    </div>

    <div class="auth-body">
      <form id="signupForm" action="/admin/signup" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-12">
            <label class="form-label fw-semibold small text-muted">BRAND / STORE NAME</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-store text-muted"></i>
              </span>
              <input type="text" class="form-control-modern form-control border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" name="memberNick" placeholder="e.g. KIXORA Flagship Store" required>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold small text-muted">OFFICIAL PHONE</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-phone text-muted"></i>
              </span>
              <input type="text" class="form-control-modern form-control border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" name="memberPhone" placeholder="998901234567" required>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label fw-semibold small text-muted">ADMIN PASSWORD</label>
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
                <i class="fa-solid fa-lock text-muted"></i>
              </span>
              <input type="password" id="signupPassword" class="form-control-modern form-control border-start-0 border-end-0" name="memberPassword" placeholder="••••••••" required>
              <button class="btn btn-light border border-start-0 btn-toggle-password" data-target="#signupPassword" type="button" style="border-radius: 0 var(--radius-md) var(--radius-md) 0; border-color: var(--light-border);">
                <i class="fa-solid fa-eye text-muted"></i>
              </button>
            </div>
          </div>

          <div class="col-12">
            <label class="form-label fw-semibold small text-muted">STORE LOGO (OPTIONAL)</label>
            <div class="d-flex align-items-center gap-3">
              <input type="file" id="memberImageInput" class="form-control-modern form-control flex-grow-1" name="memberImage" accept="image/*">
              <img id="memberImagePreview" src="" alt="Logo preview" class="rounded-circle border d-none" style="width: 52px; height: 52px; object-fit: cover;">
            </div>
          </div>

          <div class="col-12 mt-4">
            <button type="submit" class="btn-gold w-100 py-3 fs-6" style="background: linear-gradient(135deg, #ff4655, #f59e0b);">
              <span>Create Brand Account</span>
              <i class="fa-solid fa-arrow-right ms-1"></i>
            </button>
          </div>
        </div>
      </form>

      <div class="text-center mt-4">
        <span class="text-muted small">Already registered?</span>
        <a href="/admin/login" class="text-warning fw-bold text-decoration-none ms-1 small">Sign in to console</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/signup.js"></script>

<%- include('includes/footer') %>

