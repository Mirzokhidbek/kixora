<%- include('includes/header') %>

<main class="container-fluid px-lg-5 my-4 flex-grow-1">
  <!-- Minimalist Brand Hero Banner -->
  <div class="admin-card p-4 p-md-5 mb-4 position-relative overflow-hidden" style="background: var(--brand-black); color: #fff; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius-lg);">
    <div class="position-absolute end-0 bottom-0 opacity-5 d-none d-lg-block p-4" style="pointer-events: none;">
      <i class="fa-solid fa-shoe-prints" style="font-size: 14rem; color: #ffffff;"></i>
    </div>
    
    <div class="row align-items-center position-relative z-1">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-2.5 py-1 rounded-pill bg-white bg-opacity-10 text-white border border-white border-opacity-15 mb-3">
          <span class="rounded-circle" style="width: 6px; height: 6px; background: #ffffff;"></span>
          <span class="fw-semibold text-white" style="font-size: 0.75rem; letter-spacing: 0.04em;">KIXORA EXECUTIVE CONSOLE</span>
        </div>
        <h1 class="display-6 fw-bold text-white mb-2 tracking-tight">
          Welcome back, <%= member ? member.memberNick : 'Brand Director' %>
        </h1>
        <p class="text-secondary mb-4 col-md-11" style="color: #a1a1aa; line-height: 1.6; font-size: 0.92rem;">
          Real-time commerce overview: live footwear gross volume, logistics fulfillment pipelines, sneaker warehouse stock, and VIP customer records.
        </p>
        
        <div class="d-flex flex-wrap gap-2">
          <% if (member) { %>
            <a class="btn btn-light rounded-2 px-3.5 py-1.5 fw-semibold text-dark" style="font-size: 0.85rem;" href="/admin/product/all">
              <i class="fa-solid fa-shoe-prints me-1"></i> Footwear Catalog
            </a>
            <a class="btn btn-outline-light border-opacity-25 rounded-2 px-3.5 py-1.5 fw-semibold text-white" style="font-size: 0.85rem;" href="/admin/order/all">
              <i class="fa-solid fa-boxes-packing me-1"></i> Orders & Logistics
              <% if (orderMetrics && orderMetrics.pendingOrders > 0) { %>
                <span class="badge bg-white text-dark ms-1.5" style="font-size: 0.7rem;"><%= orderMetrics.pendingOrders %> Pending</span>
              <% } %>
            </a>
            <a class="btn btn-outline-light border-opacity-25 rounded-2 px-3.5 py-1.5 fw-semibold text-white" style="font-size: 0.85rem;" href="/admin/user/all">
              <i class="fa-solid fa-users me-1"></i> Customers
            </a>
          <% } else { %>
            <a class="btn btn-light rounded-2 px-3.5 py-1.5 fw-semibold text-dark" style="font-size: 0.85rem;" href="/admin/login">
              <i class="fa-solid fa-right-to-bracket me-1"></i> Login to Console
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Metrics Row (4 Clean Minimalist Stat Cards) -->
  <div class="row g-3 mb-4">
    <!-- 1. Total Revenue -->
    <div class="col-sm-6 col-xl-3">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-dollar-sign"></i>
        </div>
        <div>
          <div class="stat-title">Total Revenue</div>
          <h3 class="stat-value text-dark fw-bold mb-0">
            $<%= Number(orderMetrics ? orderMetrics.totalRevenue : 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </h3>
          <div class="text-muted small mt-0.5" style="font-size: 0.75rem;">From <%= orderMetrics ? orderMetrics.totalOrders : 0 %> Orders</div>
        </div>
      </div>
    </div>

    <!-- 2. Active Footwear Models -->
    <div class="col-sm-6 col-xl-3">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-shoe-prints"></i>
        </div>
        <div>
          <div class="stat-title">Footwear Models</div>
          <h3 class="stat-value text-dark fw-bold mb-0">
            <%= productMetrics ? productMetrics.activeProducts : 0 %> <span class="fs-6 text-muted fw-normal">/ <%= productMetrics ? productMetrics.totalProducts : 0 %></span>
          </h3>
          <% if (productMetrics && productMetrics.lowStockCount > 0) { %>
            <div class="text-danger fw-semibold mt-0.5" style="font-size: 0.75rem;">
              <i class="fa-solid fa-triangle-exclamation me-1"></i><%= productMetrics.lowStockCount %> Low Stock Alert
            </div>
          <% } else { %>
            <div class="text-success mt-0.5" style="font-size: 0.75rem;">Stock Levels Healthy</div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 3. Connected VIPs / Customers -->
    <div class="col-sm-6 col-xl-3">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-users"></i>
        </div>
        <div>
          <div class="stat-title">VIP Customers</div>
          <h3 class="stat-value text-dark fw-bold mb-0"><%= userCount || 0 %></h3>
          <div class="text-muted mt-0.5" style="font-size: 0.75rem;">Registered Members</div>
        </div>
      </div>
    </div>

    <!-- 4. Pending Logistics -->
    <div class="col-sm-6 col-xl-3">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fa-solid fa-boxes-packing"></i>
        </div>
        <div>
          <div class="stat-title">Pending Logistics</div>
          <h3 class="stat-value text-dark fw-bold mb-0"><%= orderMetrics ? (orderMetrics.pendingOrders + orderMetrics.processOrders) : 0 %></h3>
          <div class="text-muted mt-0.5" style="font-size: 0.75rem;">
            <span><%= orderMetrics ? orderMetrics.pendingOrders : 0 %> Pending</span> &bull; 
            <span><%= orderMetrics ? orderMetrics.processOrders : 0 %> In Transit</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Charts Row (Colorful Charts & Graphics Area) -->
  <div class="row g-3 mb-4">
    <!-- Chart 1: Revenue Dynamics (Colorful Gradient Picture/Graphic Area) -->
    <div class="col-lg-8">
      <div class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold text-dark mb-0">Sales & Revenue Dynamics</h6>
            <p class="text-muted mb-0" style="font-size: 0.78rem;">Monthly footwear sales volume ($)</p>
          </div>
          <div class="badge bg-light text-dark border px-2.5 py-1" style="font-size: 0.72rem; font-weight: 600;">
            Last 6 Months
          </div>
        </div>
        <div style="height: 280px; position: relative;">
          <canvas id="revenueChart"></canvas>
        </div>
      </div>
    </div>

    <!-- Chart 2: Collection Breakdown (Colorful Multi-Color Doughnut Picture/Graphic Area) -->
    <div class="col-lg-4">
      <div class="admin-card p-4 d-flex flex-column justify-content-between" style="height: 100%;">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div>
            <h6 class="fw-bold text-dark mb-0">Catalog Breakdown</h6>
            <p class="text-muted mb-0" style="font-size: 0.78rem;">Models by collection</p>
          </div>
        </div>
        
        <div style="height: 210px; position: relative;" class="d-flex align-items-center justify-content-center my-2">
          <canvas id="categoryChart"></canvas>
        </div>

        <div class="d-flex justify-content-around text-center pt-2.5 border-top" style="border-color: var(--border-light) !important;">
          <div>
            <div class="text-muted" style="font-size: 0.72rem;">Sneakers</div>
            <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= productMetrics && productMetrics.categoryBreakdown ? (productMetrics.categoryBreakdown['SNEAKERS'] || productMetrics.categoryBreakdown['DISH'] || 0) : 0 %></div>
          </div>
          <div>
            <div class="text-muted" style="font-size: 0.72rem;">Running</div>
            <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= productMetrics && productMetrics.categoryBreakdown ? (productMetrics.categoryBreakdown['RUNNING'] || productMetrics.categoryBreakdown['SALAD'] || 0) : 0 %></div>
          </div>
          <div>
            <div class="text-muted" style="font-size: 0.72rem;">Boots</div>
            <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= productMetrics && productMetrics.categoryBreakdown ? (productMetrics.categoryBreakdown['BOOTS'] || productMetrics.categoryBreakdown['DESSERT'] || 0) : 0 %></div>
          </div>
          <div>
            <div class="text-muted" style="font-size: 0.72rem;">Limited Drop</div>
            <div class="fw-bold text-dark" style="font-size: 0.85rem;"><%= productMetrics && productMetrics.categoryBreakdown ? (productMetrics.categoryBreakdown['LIMITED_DROP'] || productMetrics.categoryBreakdown['DRINK'] || 0) : 0 %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Chart.js Colorful Initialization Script (Vibrant Colors Applied ONLY to the Charts) -->
<script>
  $(document).ready(function() {
    // 1. Revenue Chart with Vibrant Gradient & Colored Points
    const months = <%- JSON.stringify(orderMetrics && orderMetrics.monthlySales ? orderMetrics.monthlySales.months : ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]) %>;
    const revenues = <%- JSON.stringify(orderMetrics && orderMetrics.monthlySales ? orderMetrics.monthlySales.revenues : [0, 0, 0, 0, 0, 0]) %>;

    const ctxRev = document.getElementById('revenueChart');
    if (ctxRev) {
      const chartCtx = ctxRev.getContext('2d');
      
      // Vibrant Gradient Fill under the line
      const gradientFill = chartCtx.createLinearGradient(0, 0, 0, 300);
      gradientFill.addColorStop(0, 'rgba(99, 102, 241, 0.45)');
      gradientFill.addColorStop(0.6, 'rgba(236, 72, 153, 0.15)');
      gradientFill.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

      // Vibrant Stroke Gradient for the line
      const strokeGradient = chartCtx.createLinearGradient(0, 0, ctxRev.width || 600, 0);
      strokeGradient.addColorStop(0, '#6366f1');
      strokeGradient.addColorStop(0.5, '#a855f7');
      strokeGradient.addColorStop(1, '#ec4899');

      new Chart(ctxRev, {
        type: 'line',
        data: {
          labels: months,
          datasets: [{
            label: 'Monthly Revenue ($)',
            data: revenues,
            borderColor: strokeGradient,
            backgroundColor: gradientFill,
            fill: true,
            tension: 0.4,
            borderWidth: 3.5,
            pointBackgroundColor: '#ffffff',
            pointBorderColor: '#6366f1',
            pointBorderWidth: 3,
            pointRadius: 6,
            pointHoverRadius: 9,
            pointHoverBackgroundColor: '#ec4899',
            pointHoverBorderColor: '#ffffff',
            pointHoverBorderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#090a0f',
              titleColor: '#e0e7ff',
              bodyColor: '#38bdf8',
              bodyFont: { weight: 'bold', size: 13 },
              padding: 12,
              cornerRadius: 10,
              borderColor: 'rgba(99, 102, 241, 0.4)',
              borderWidth: 1,
              callbacks: {
                label: function(context) {
                  return ' Revenue: $' + Number(context.raw).toFixed(2);
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              grid: { 
                color: 'rgba(226, 232, 240, 0.6)',
                drawBorder: false
              },
              ticks: {
                callback: function(value) { return '$' + value; },
                color: '#71717a',
                font: { size: 11, weight: '500' }
              }
            },
            x: {
              grid: { display: false },
              ticks: { 
                color: '#71717a',
                font: { size: 11, weight: '600' }
              }
            }
          }
        }
      });
    }

    // 2. Collection Breakdown with Vibrant Palette (Colors on the Chart Doughnut)
    const categoryData = <%- JSON.stringify(productMetrics && productMetrics.categoryBreakdown ? productMetrics.categoryBreakdown : {}) %>;
    const catLabels = ['Sneakers', 'Running', 'Boots', 'Limited Drop'];
    const catValues = [
      categoryData['SNEAKERS'] || categoryData['DISH'] || 1,
      categoryData['RUNNING'] || categoryData['SALAD'] || 1,
      categoryData['BOOTS'] || categoryData['DESSERT'] || 1,
      categoryData['LIMITED_DROP'] || categoryData['DRINK'] || 1
    ];

    const ctxCat = document.getElementById('categoryChart');
    if (ctxCat) {
      new Chart(ctxCat, {
        type: 'doughnut',
        data: {
          labels: catLabels,
          datasets: [{
            data: catValues,
            backgroundColor: [
              '#6366f1', // Sneakers: Royal Indigo
              '#ff4655', // Running: Coral Crimson
              '#f59e0b', // Boots: Radiant Amber
              '#10b981'  // Limited Drop: Emerald Teal
            ],
            hoverBackgroundColor: [
              '#4f46e5',
              '#e11d48',
              '#d97706',
              '#059669'
            ],
            borderWidth: 3,
            borderColor: '#ffffff',
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'bottom',
              labels: { 
                boxWidth: 12, 
                boxHeight: 12,
                borderRadius: 4,
                useBorderRadius: true,
                padding: 14,
                font: { size: 11, weight: '600' },
                color: '#334155'
              }
            },
            tooltip: {
              backgroundColor: '#090a0f',
              titleColor: '#ffffff',
              bodyColor: '#fbbf24',
              bodyFont: { weight: 'bold' },
              padding: 10,
              cornerRadius: 8,
              callbacks: {
                label: function(context) {
                  return ' ' + context.label + ': ' + context.raw + ' models';
                }
              }
            }
          },
          cutout: '68%'
        }
      });
    }
  });
</script>

<%- include('includes/footer') %>
