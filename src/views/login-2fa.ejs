<%- include('includes/header') %>

<main class="container my-5 flex-grow-1" style="max-width: 420px;">
  <div class="admin-card p-4">
    <h2 class="fw-bold mb-1" style="font-size: 1.3rem;">Two-step verification</h2>
    <p class="text-muted small mb-3">Enter the 6-digit code from your authenticator app.</p>
    <form method="POST" action="/admin/login/2fa" autocomplete="off">
      <input type="text" name="code" class="form-control-modern w-100 mb-3 text-center fs-4"
             inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required autofocus>
      <button type="submit" class="btn-brand-dark w-100 rounded-2 py-2">Verify</button>
    </form>
    <a class="d-block text-center small mt-3 text-muted" href="/admin/login">Use a different account</a>
  </div>
</main>

<%- include('includes/footer') %>
