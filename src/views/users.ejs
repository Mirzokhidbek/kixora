<%- include('includes/header') %>

<main class="container-fluid px-lg-5 my-4 flex-grow-1">
  <!-- Title Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h2 class="fw-bold text-dark mb-0 tracking-tight" style="font-size: 1.45rem;">Customer Accounts</h2>
        <span class="badge bg-dark text-white rounded-pill px-2.5 py-1" style="font-size: 0.75rem; font-weight: 600;">
          <%= users ? users.length : 0 %> Members
        </span>
      </div>
      <p class="text-muted mb-0 small">
        Community accounts, loyalty reward points, standing, and authentication status.
      </p>
    </div>
  </div>

  <!-- Search Customers Bar -->
  <div class="admin-card p-3 mb-4">
    <div class="row g-2 align-items-center">
      <div class="col-md-6">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0 text-muted" style="border-color: var(--border-light); font-size: 0.85rem;">
            <i class="fa-solid fa-magnifying-glass"></i>
          </span>
          <input type="text" id="userSearchInput" class="form-control border-start-0 ps-0 bg-white" style="border-color: var(--border-light); font-size: 0.88rem;" placeholder="Search customer name, email, or phone number...">
        </div>
      </div>
      <div class="col-md-6 text-md-end">
        <span class="text-muted small">Showing all authenticated sneaker community members</span>
      </div>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="admin-table-container">
    <div class="table-responsive">
      <table class="table admin-table align-middle mb-0" id="usersTable">
        <thead>
          <tr>
            <th scope="col" class="ps-4">#</th>
            <th scope="col">Member</th>
            <th scope="col">Contact</th>
            <th scope="col">Loyalty Points</th>
            <th scope="col">Joined Date</th>
            <th scope="col">Status</th>
            <th scope="col" class="text-center">Points</th>
            <th scope="col" class="text-center pe-4">Account Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (users && users.length) { %>
            <% users.forEach((user, index) => { %>
              <tr class="user-row"
                  data-name="<%= (user.memberNick || '').toLowerCase() %>"
                  data-email="<%= (user.memberEmail || '').toLowerCase() %>"
                  data-phone="<%= (user.memberPhone || '').toLowerCase() %>">
                <td class="ps-4 fw-bold text-muted" style="font-size: 0.8rem;"><%= index + 1 %></td>
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <% if (user.memberImage) { %>
                      <img src="/<%= user.memberImage.replace('public/', '') %>" alt="<%= user.memberNick %>" class="rounded-circle" style="width: 34px; height: 34px; object-fit: cover;">
                    <% } else { %>
                      <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.85rem;">
                        <%= user.memberNick ? user.memberNick.charAt(0).toUpperCase() : 'U' %>
                      </div>
                    <% } %>
                    <div>
                      <div class="fw-bold text-dark" style="font-size: 0.88rem;"><%= user.memberNick %></div>
                      <div class="text-muted font-monospace" style="font-size: 0.72rem;">ID: <%= String(user._id).substring(0, 8) %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="fw-semibold text-dark" style="font-size: 0.84rem;"><%= user.memberEmail || user.memberPhone %></div>
                  <div class="text-muted" style="font-size: 0.76rem;"><%= user.memberPhone %></div>
                </td>
                <td>
                  <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold" id="user-points-badge-<%= user._id %>" style="font-size: 0.78rem;">
                    <i class="fa-solid fa-coins me-1 text-secondary"></i> <%= user.memberPoints || 0 %> pts
                  </span>
                </td>
                <td>
                  <span class="text-muted" style="font-size: 0.78rem;">
                    <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </span>
                </td>
                <td>
                  <span id="user-badge-<%= user._id %>" class="badge-status <%= user.memberStatus.toLowerCase() %>">
                    <%= user.memberStatus %>
                  </span>
                </td>
                <td class="text-center">
                  <button type="button" 
                          class="btn-brand-outline rounded-2 px-2.5 py-1 adjust-points-trigger"
                          style="font-size: 0.78rem;"
                          data-id="<%= user._id %>"
                          data-name="<%= user.memberNick %>"
                          data-points="<%= user.memberPoints || 0 %>">
                    <i class="fa-solid fa-coins me-1 text-secondary"></i> Adjust
                  </button>
                </td>
                <td class="text-center pe-4">
                  <select class="form-select-modern form-select-sm user-status-select" style="font-size: 0.78rem; padding: 0.35rem 0.65rem;" data-id="<%= user._id %>">
                    <option value="ACTIVE" <%= user.memberStatus === 'ACTIVE' ? 'selected' : '' %>>ACTIVE</option>
                    <option value="BLOCK" <%= user.memberStatus === 'BLOCK' ? 'selected' : '' %>>BLOCK</option>
                    <option value="DELETE" <%= user.memberStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                  </select>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <div class="p-4">
                  <i class="fa-solid fa-users-slash fa-2x mb-2 text-muted d-block opacity-50"></i>
                  <div class="fw-bold text-dark">No Customer Accounts Found</div>
                  <p class="small text-muted mb-0">When customers sign up through the store, they will appear here automatically.</p>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Adjust Loyalty Points Modal -->
  <div class="modal fade" id="adjustPointsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content overflow-hidden">
        <div class="modal-header bg-dark text-white border-0 py-3 px-4">
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-coins text-muted"></i>
            <h6 class="modal-title fw-bold mb-0">Adjust Loyalty Points</h6>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form id="adjustPointsForm">
          <input type="hidden" id="adjustPointsUserId">
          <div class="modal-body p-4 bg-white">
            <div class="mb-3">
              <label class="form-label text-muted fw-bold small" style="font-size: 0.72rem; letter-spacing: 0.05em;">CUSTOMER</label>
              <div class="fw-bold text-dark" style="font-size: 1.1rem;" id="adjustPointsUserName">Customer Name</div>
            </div>

            <div class="mb-3">
              <label class="form-label text-muted fw-bold small" style="font-size: 0.72rem; letter-spacing: 0.05em;">SET LOYALTY POINTS (PTS)</label>
              <input type="number" class="form-control-modern w-100" id="adjustPointsValue" min="0" required>
              <div class="small text-muted mt-1" style="font-size: 0.75rem;">Customers can redeem points for checkout discounts.</div>
            </div>
          </div>

          <div class="modal-footer bg-light border-0 py-2.5 px-4">
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn-brand-dark rounded-2 px-3 py-1.5" id="savePointsBtn">
              <i class="fa-solid fa-check me-1"></i> Save Points
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<script src="/js/users.js"></script>

<%- include('includes/footer') %>
