<%- include('includes/header') %>

<!-- Custom Modern UI/UX Styles for KIXORA Admin Login -->
<style>
  .kixora-auth-bg {
    min-height: calc(100vh - 120px);
    background: radial-gradient(circle at 10% 20%, #fff7ed 0%, #fef3c7 25%, #fbf8f5 55%, #f4f4f5 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .auth-split-card {
    max-width: 980px;
    width: 100%;
    background: #ffffff;
    border-radius: 28px;
    box-shadow: 0 25px 60px -15px rgba(234, 88, 12, 0.14), 0 10px 30px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(226, 232, 240, 0.8);
    display: flex;
    overflow: hidden;
  }

  /* Left Showcase Panel */
  .auth-showcase-panel {
    width: 44%;
    background: linear-gradient(160deg, #fff7ed 0%, #fed7aa 40%, #fdba74 80%, #fb923c 100%);
    padding: 44px 38px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  /* Ambient wave gradient in background */
  .auth-showcase-panel::before {
    content: '';
    position: absolute;
    bottom: -20%;
    left: -20%;
    width: 140%;
    height: 70%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.4) 0%, rgba(254, 215, 170, 0.1) 70%, transparent 100%);
    filter: blur(20px);
    pointer-events: none;
  }

  .brand-badge-square {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ff4e17, #ff8c00);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 1.25rem;
    box-shadow: 0 8px 18px rgba(255, 78, 23, 0.35);
  }

  .brand-logo-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .hero-headline {
    font-family: 'Outfit', sans-serif;
    font-size: 2.3rem;
    font-weight: 900;
    line-height: 1.15;
    color: #0f172a;
    letter-spacing: -0.03em;
    margin-top: 24px;
    margin-bottom: 12px;
  }

  .hero-headline .highlight-orange {
    color: #ea580c;
    background: linear-gradient(135deg, #ff4500 0%, #ff8c00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    color: #475569;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.55;
  }

  /* 3D Glass Artwork Card */
  .glass-art-stage {
    position: relative;
    margin: 28px auto 20px;
    width: 170px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glass-art-card {
    width: 130px;
    height: 130px;
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 40px rgba(234, 88, 12, 0.18), 0 4px 12px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-5deg);
    transition: transform 0.3s ease;
  }

  .glass-art-card:hover {
    transform: rotate(0deg) scale(1.04);
  }

  .glass-art-icon {
    font-size: 3.2rem;
    background: linear-gradient(135deg, #ff4e17, #ff8c00);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .floating-badge {
    position: absolute;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ea580c;
  }

  .floating-badge-store {
    top: 4px;
    right: 4px;
    width: 40px;
    height: 40px;
    font-size: 1.05rem;
  }

  .floating-badge-chart {
    bottom: 2px;
    right: -2px;
    width: 38px;
    height: 38px;
    font-size: 0.95rem;
  }

  .left-footer-tagline {
    color: #475569;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.4;
  }

  /* Right Form Panel */
  .auth-form-panel {
    width: 56%;
    background: #ffffff;
    padding: 48px 46px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .lang-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
    background: #ffffff;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .lang-pill-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #0f172a;
  }

  .form-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.1rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.03em;
    margin-bottom: 6px;
  }

  .form-subtitle {
    color: #64748b;
    font-size: 0.95rem;
    margin-bottom: 28px;
  }

  .custom-form-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 8px;
    display: block;
  }

  /* Custom Input Wrapper */
  .custom-input-box {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 14px;
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .custom-input-box:focus-within {
    border-color: #ff6422;
    box-shadow: 0 0 0 4px rgba(255, 100, 34, 0.12);
    background: #ffffff;
  }

  .input-icon-pill {
    width: 44px;
    height: 38px;
    margin-left: 7px;
    border-radius: 10px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .custom-input-field {
    width: 100%;
    height: 52px;
    border: none;
    background: transparent;
    padding: 0 16px 0 12px;
    font-size: 0.95rem;
    font-weight: 500;
    color: #0f172a;
    outline: none;
  }

  .custom-input-field::placeholder {
    color: #94a3b8;
    font-weight: 400;
  }

  .input-action-btn {
    border: none;
    background: transparent;
    padding: 0 16px;
    color: #64748b;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .input-action-btn:hover {
    color: #0f172a;
  }

  /* Custom Checkbox */
  .custom-checkbox-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }

  .custom-checkbox-wrap input[type="checkbox"] {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    accent-color: #ea580c;
    cursor: pointer;
  }

  .forgot-link {
    color: #ea580c;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .forgot-link:hover {
    color: #c2410c;
    text-decoration: underline;
  }

  /* Primary Gradient Button */
  .btn-kixora-primary {
    width: 100%;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #ff4500 0%, #ff8c00 100%);
    border: none;
    color: #ffffff;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-shadow: 0 10px 24px -2px rgba(255, 69, 0, 0.4);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .btn-kixora-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -2px rgba(255, 69, 0, 0.5);
    background: linear-gradient(135deg, #ff3300 0%, #ff7f00 100%);
  }

  .btn-kixora-primary:active {
    transform: translateY(0);
  }

  /* Custom Divider */
  .auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    color: #94a3b8;
    font-size: 0.84rem;
    font-weight: 600;
    margin: 24px 0;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e2e8f0;
  }

  .auth-divider:not(:empty)::before {
    margin-right: 1rem;
  }

  .auth-divider:not(:empty)::after {
    margin-left: 1rem;
  }

  /* Register Account Box */
  .register-card-box {
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #ffffff;
    color: #475569;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .register-card-box:hover {
    border-color: #ea580c;
    background: #fffaf5;
    color: #0f172a;
    box-shadow: 0 4px 16px rgba(234, 88, 12, 0.08);
  }

  /* Responsive Adjustments */
  @media (max-width: 860px) {
    .auth-split-card {
      flex-direction: column;
      max-width: 480px;
    }
    .auth-showcase-panel {
      width: 100%;
      padding: 36px 28px;
    }
    .auth-form-panel {
      width: 100%;
      padding: 36px 28px;
    }
    .glass-art-stage {
      margin: 18px auto 14px;
    }
  }
</style>

<div class="kixora-auth-bg">
  <div class="auth-split-card">
    
    <!-- 1. LEFT BRANDING & 3D ARTWORK PANEL -->
    <div class="auth-showcase-panel">
      <!-- Top Logo -->
      <div>
        <div class="d-flex align-items-center gap-2.5">
          <div class="brand-badge-square">
            <i class="fa-solid fa-shoe-prints"></i>
          </div>
          <span class="brand-logo-text">Kixora</span>
        </div>

        <h1 class="hero-headline">
          Your Brand,<br>
          <span class="highlight-orange">Your Inventory</span>
        </h1>
        <p class="hero-description">
          Secure access to manage your store, products and grow your business.
        </p>
      </div>

      <!-- 3D Floating Glass Graphic -->
      <div class="glass-art-stage">
        <div class="glass-art-card">
          <i class="fa-solid fa-shoe-prints glass-art-icon"></i>
        </div>
        <div class="floating-badge floating-badge-store" title="Storefront Suite">
          <i class="fa-solid fa-store"></i>
        </div>
        <div class="floating-badge floating-badge-chart" title="Analytics & Growth">
          <i class="fa-solid fa-chart-simple"></i>
        </div>
      </div>

      <!-- Bottom Tagline -->
      <div class="left-footer-tagline">
        Better tools.<br>
        Bigger dreams.
      </div>
    </div>

    <!-- 2. RIGHT LOGIN FORM PANEL -->
    <div class="auth-form-panel">
      <!-- Top Language Selector -->
      <div class="d-flex justify-content-end mb-2">
        <a href="javascript:void(0)" class="lang-pill-btn">
          <i class="fa-solid fa-globe text-muted"></i>
          <span>English</span>
          <i class="fa-solid fa-chevron-down text-muted" style="font-size: 0.65rem;"></i>
        </a>
      </div>

      <!-- Form Heading -->
      <div>
        <h2 class="form-title">Welcome Back</h2>
        <p class="form-subtitle">Sign in to your Kixora store account</p>

        <!-- Login Form -->
        <form action="/admin/login" method="POST">
          <!-- Store Nickname Input -->
          <div class="mb-3.5">
            <label class="custom-form-label">Brand / Store Nickname</label>
            <div class="custom-input-box">
              <div class="input-icon-pill">
                <i class="fa-solid fa-store"></i>
              </div>
              <input
                type="text"
                class="custom-input-field"
                name="memberNick"
                placeholder="e.g. KixoraStore"
                autocomplete="username"
                required
              />
            </div>
          </div>

          <!-- Password Input -->
          <div class="mb-3.5">
            <label class="custom-form-label">Password</label>
            <div class="custom-input-box">
              <div class="input-icon-pill">
                <i class="fa-solid fa-key"></i>
              </div>
              <input
                type="password"
                id="adminPasswordInput"
                class="custom-input-field"
                name="memberPassword"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              />
              <button
                type="button"
                id="togglePasswordBtn"
                class="input-action-btn"
                title="Show / Hide Password"
              >
                <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
              </button>
            </div>
          </div>

          <!-- Remember Me & Forgot Password Row -->
          <div class="d-flex justify-content-between align-items-center mb-4 pt-1">
            <label class="custom-checkbox-wrap">
              <input type="checkbox" name="rememberMe" checked />
              <span style="color: #475569; font-size: 0.88rem; font-weight: 600;">Remember me</span>
            </label>
            <a href="javascript:void(0)" onclick="alert('Please contact KIXORA Master Director to reset your administrative credentials.')" class="forgot-link">
              Forgot password?
            </a>
          </div>

          <!-- Authenticate & Login Button -->
          <button type="submit" class="btn-kixora-primary">
            <span>Authenticate & Login</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>

        <!-- Divider -->
        <div class="auth-divider">or</div>

        <!-- Register Account Box -->
        <a href="/admin/signup" class="register-card-box">
          <i class="fa-solid fa-user-plus text-muted"></i>
          <span>New brand partner? <strong style="color: #ea580c;">Register Account</strong></span>
        </a>
      </div>

      <!-- Empty spacer for vertical balance -->
      <div style="height: 6px;"></div>
    </div>

  </div>
</div>

<!-- Password Toggle Script -->
<script>
  $(document).ready(function() {
    $('#togglePasswordBtn').on('click', function() {
      const passwordInput = $('#adminPasswordInput');
      const icon = $('#togglePasswordIcon');
      const isPassword = passwordInput.attr('type') === 'password';

      passwordInput.attr('type', isPassword ? 'text' : 'password');
      if (isPassword) {
        icon.removeClass('fa-eye').addClass('fa-eye-slash');
      } else {
        icon.removeClass('fa-eye-slash').addClass('fa-eye');
      }
    });
  });
</script>

<%- include('includes/footer') %>
