<%- include('includes/header') %>

<div class="auth-wrapper flex-grow-1">
  <div class="auth-card">
    <div class="auth-header">
      <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.3rem; background: linear-gradient(135deg, #ff4655, #f59e0b);">
        <i class="fa-solid fa-shoe-prints"></i>
      </div>
      <h3 class="fw-bold mb-1">KIXORA Brand Login</h3>
      <p class="text-slate-400 small mb-0" style="color: #94a3b8;">Enter brand admin credentials to access inventory suite</p>
    </div>

    <div class="auth-body">
      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label class="form-label fw-semibold small text-muted">BRAND / STORE NICKNAME</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
              <i class="fa-solid fa-store text-muted"></i>
            </span>
            <input type="text" class="form-control-modern form-control border-start-0" style="border-radius: 0 var(--radius-md) var(--radius-md) 0;" name="memberNick" placeholder="e.g. KixoraStore" required>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between">
            <label class="form-label fw-semibold small text-muted">PASSWORD</label>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--light-border);">
              <i class="fa-solid fa-key text-muted"></i>
            </span>
            <input type="password" id="loginPassword" class="form-control-modern form-control border-start-0 border-end-0" name="memberPassword" placeholder="••••••••" required>
            <button class="btn btn-light border border-start-0 btn-toggle-password" data-target="#loginPassword" type="button" style="border-radius: 0 var(--radius-md) var(--radius-md) 0; border-color: var(--light-border);">
              <i class="fa-solid fa-eye text-muted"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-gold w-100 py-3 fs-6" style="background: linear-gradient(135deg, #ff4655, #f59e0b);">
          <span>Authenticate & Login</span>
          <i class="fa-solid fa-arrow-right-to-bracket ms-1"></i>
        </button>
      </form>

      <div class="text-center mt-4">
        <span class="text-muted small">New brand partner?</span>
        <a href="/admin/signup" class="text-warning fw-bold text-decoration-none ms-1 small">Register Account</a>
      </div>
    </div>
  </div>
</div>

<%- include('includes/footer') %>

