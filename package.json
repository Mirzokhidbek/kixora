{
  "name": "kixora-server",
  "version": "1.0.0",
  "description": "KIXORA Luxury Footwear Backend API & Admin Portal",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && cp -r src/views dist/views",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "train": "nodemon --exec ts-node src/train.ts",
    "test:e2e": "node --require ts-node/register --test --test-concurrency=1 --test-force-exit --test-timeout=120000 test/e2e/*.e2e.test.ts"
  },
  "author": "MIT",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^9.47.2",
    "bcryptjs": "^3.0.3",
    "connect-mongodb-session": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.29.4",
    "mongoose": "^8.24.6",
    "morgan": "^1.11.0",
    "multer": "^2.3.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "mongodb-memory-server-core": "^10.4.3",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
