# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3001

# MongoDB connection string (MONGO_DEV is also accepted for local development)
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# Long random strings, e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=
SESSION_SECRET=

# Comma-separated list of SPA origins allowed to call the API with credentials
ALLOWED_ORIGINS=http://localhost:8080

# Google sign-in verification
FIREBASE_PROJECT_ID=kixora-99964
# Optional: only needed if the client uses Google Identity Services instead of Firebase
GOOGLE_CLIENT_ID=

# AI search (optional; the endpoint returns 503 when missing)
GEMINI_API_KEY=

# Payments: "test" = simulated provider (no real money), "manual" = admin confirms.
# Defaults: test in development, manual in production.
PAYMENT_MODE=

# Optional shared Redis (rate limits, caches, member-status cache). Required to run more than one instance.
REDIS_URL=

# Where uploaded images are stored. On Railway mount a Volume and point here (e.g. /data/uploads).
UPLOAD_DIR=

# Optional error monitoring
SENTRY_DSN=

# Outgoing email (password reset, email confirmation, store notifications).
# Without it, development logs the email (with its link) instead of sending; production logs an error.
SMTP_URL=
MAIL_FROM="KIXORA <no-reply@your-domain.uz>"
# Optional: new contact-form messages are announced here
STORE_NOTIFY_EMAIL=
# Public URLs used inside emails
PUBLIC_APP_URL=https://kixora.vercel.app
PUBLIC_SERVER_URL=https://burak-backend-production.up.railway.app

# Encrypts admin 2FA secrets at rest (defaults to a key derived from JWT_SECRET).
# Set it once and keep it: changing it forces admins to re-enroll 2FA.
DATA_ENCRYPTION_KEY=
